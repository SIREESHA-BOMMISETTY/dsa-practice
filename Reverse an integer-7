class Solution:
    def reverse(self, x: int) -> int:
        if x < 0:
            sign =-1
            x=abs(x)
        else:
            sign = 1    
        res = 0

        while x > 0:
            res = res * 10 + x%10 
            x //= 10
            print(res)
        if res < -2**31 or res >(2**31)-1:
            return 0
        else:
              return res*sign       
